# Copy to .env on the server (sourced by setup.sh and launch.sh)
VLA_DATA=/path/data/vla
VLA_RUNS=/path/runs/vla
MASTER=localhost
# DGX Station: index 3 is the 4 GB display card; A100s are 0,1,2,4
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0,1,2,4
# EGL device ids of the A100s (set after running setup.sh; may differ from CUDA order)
VLA_EGL_DEVICES=0,1,2,3
# Server home is NFS with a tight quota: keep the venv + uv cache in RAM-backed /dev/shm (re-run setup.sh after reboot)
UV_PROJECT_ENVIRONMENT=/dev/shm/USER_vla_venv
UV_CACHE_DIR=/dev/shm/USER_uvcache
UV_LINK_MODE=copy
